+# An inline code span is literal text just like a fence: `<UNK>` written in
+# prose is code, and escaping inside it renders a visible `&lt;` to the reader.
+INLINE_CODE_RE = re.compile(r"(`+)(?:(?!\1)[\s\S])+\1")
+LITERAL_LT_RE = re.compile(r"<(?![a-zA-Z/!])")
+
+
+def escape_mdx(text: str) -> str:
+    """Escape characters MDX would read as JSX, outside code.
+
+    MDX 3 treats `<` as the start of a JSX tag, so prose like "under <1,000
+    lines" or "<UNK>" fails to compile. Inside fenced code blocks and inline
+    code spans these must be left exactly as written, so both are stepped over
+    rather than rewritten.
+    """
+    out, in_fence = [], False
+    for line in text.split("\n"):
+        stripped = line.lstrip()
+        if stripped.startswith(("```", "~~~")):
+            in_fence = not in_fence
+            out.append(line)
+            continue
+        if in_fence:
+            out.append(line)
+            continue
+        out.append(escape_outside_code(line))
+    return "\n".join(out)
+
+
+def escape_outside_code(line: str) -> str:
+    """Escape one line's literal `<`, leaving inline code spans verbatim."""
+    parts, pos = [], 0
+    for m in INLINE_CODE_RE.finditer(line):
+        # A `<` that is not opening a tag or a closing tag is literal text.
+        parts.append(LITERAL_LT_RE.sub("&lt;", line[pos:m.start()]))
+        parts.append(m.group(0))
+        pos = m.end()
+    parts.append(LITERAL_LT_RE.sub("&lt;", line[pos:]))
+    return "".join(parts)
 
 
