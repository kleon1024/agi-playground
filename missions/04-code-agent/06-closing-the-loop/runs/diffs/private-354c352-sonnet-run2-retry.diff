+        # A `<` that is not opening a tag or a closing tag is literal text,
+        # but not inside inline code spans, which must be left verbatim.
+        parts = INLINE_CODE_RE.split(line)
+        codes = INLINE_CODE_RE.findall(line)
+        rebuilt = []
+        for i, part in enumerate(parts):
+            rebuilt.append(re.sub(r"<(?![a-zA-Z/!])", "&lt;", part))
