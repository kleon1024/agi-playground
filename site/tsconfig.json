// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    // src/reading-cost.generated.json is written by sync-docs.py and imported
    // by ReadingMap.tsx, so a route's declared cost is derived from the same
    // word count as the badge on each page rather than typed alongside it.
    "resolveJsonModule": true
  },
  "exclude": [".docusaurus", "build"]
}
