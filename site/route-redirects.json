{
  "_why": [
    "Routes that moved. Every entry keeps a URL that was published and indexed",
    "resolving after a chapter changed owners.",
    "`from` is the route as it was served, without the /playground/ baseUrl --",
    "the plugin prepends it. `to` must resolve in the current build or the build",
    "fails, which is the point: a redirect that rots is worse than none.",
    "Append here when a chapter moves; never delete an entry, because the old",
    "URL stays in somebody's history forever."
  ],
  "redirects": [
    {
      "from": "/capabilities",
      "to": "/missions"
    },
    {
      "from": "/capabilities/act-coordinate",
      "to": "/missions/01-language-model-agent/06-agent"
    },
    {
      "from": "/capabilities/act-coordinate/LANDSCAPE",
      "to": "/missions/01-language-model-agent/06-agent/LANDSCAPE"
    },
    {
      "from": "/capabilities/act-coordinate/01-multi-agent",
      "to": "/missions/01-language-model-agent/06-agent/would-a-second-agent-help"
    },
    {
      "from": "/capabilities/act-coordinate/01-multi-agent/prod",
      "to": "/missions/01-language-model-agent/06-agent/would-a-second-agent-help/prod"
    },
    {
      "from": "/platform/serving",
      "to": "/missions/01-language-model-agent/05-serve"
    },
    {
      "from": "/platform/serving/LANDSCAPE",
      "to": "/missions/01-language-model-agent/05-serve/LANDSCAPE"
    },
    {
      "from": "/platform/serving/01-graph-execution",
      "to": "/missions/01-language-model-agent/05-serve/graph-execution"
    },
    {
      "from": "/platform/serving/02-quantization",
      "to": "/missions/01-language-model-agent/05-serve/quantization"
    },
    {
      "from": "/platform/serving/03-speculative-decoding",
      "to": "/missions/01-language-model-agent/05-serve/speculative-decoding"
    }
  ]
}
