     def read(self, layer: int, upto: int) -> tuple[torch.Tensor, torch.Tensor]:
         return self.buf[layer, 0, :, :upto], self.buf[layer, 1, :, :upto]
 
 
+def _causal_mask(T: int, start_pos: int, device) -> torch.Tensor:
+    """Boolean attention mask for T queries at absolute positions
+    `start_pos .. start_pos+T` over the `start_pos + T` keys already held in
+    the cache: query i may read key j exactly when `j <= start_pos + i`.
+
+    `F.scaled_dot_product_attention(..., is_causal=True)` cannot express
+    this. For a non-square (T_q, T_k) it builds the mask *top-left* aligned —
+    `j <= i` counted from the start of the key block — so a decode step (one
+    query against N cached keys) would attend to key 0 alone and its logits
+    would diverge from a full recompute. Prefill, where T_q == T_k, is the
+    only case in which the built-in mask and this one agree.
+    """
+    q_pos = torch.arange(start_pos, start_pos + T, device=device).unsqueeze(1)
+    k_pos = torch.arange(start_pos + T, device=device).unsqueeze(0)
+    return (k_pos <= q_pos).view(1, 1, T, start_pos + T)
+
