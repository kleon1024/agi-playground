+# An inline code span is code, so MDX never reads its `<` as a tag. Escaping
+# inside one would show a literal `&lt;` to the reader between the backticks.
+INLINE_CODE_RE = re.compile(r"(?P<ticks>`+)(?P<code>.+?)(?P=ticks)")
+
+
+def _escape_prose(text: str) -> str:
+    # A `<` that is not opening a tag or a closing tag is literal text.
+    return re.sub(r"<(?![a-zA-Z/!])", "&lt;", text)
+
+
+def _escape_outside_inline_code(line: str) -> str:
+    out, pos = [], 0
+    for m in INLINE_CODE_RE.finditer(line):
+        out.append(_escape_prose(line[pos:m.start()]))
+        out.append(m.group(0))
+        pos = m.end()
+    out.append(_escape_prose(line[pos:]))
+    return "".join(out)
+
